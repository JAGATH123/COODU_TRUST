# OS junk
.DS_Store
**/.DS_Store

# Secrets — NEVER commit. If any of these were ever pushed, ROTATE the keys.
.env
**/.env
!**/.env.example

# Node dependencies (regenerable via npm install)
node_modules/
**/node_modules/

# Large, regenerable verification screenshots
design/renders-site/
design/redesign-renders/

# Logs
*.log

# Large design exports / renders (regenerable)
**/*.zip

# Dev / design artifacts — kept locally + in git history, not part of the shipped site
/.claude/
/.superpowers/
/.superdesign/
/design/
/docs/
/About page content/
/Adding globe to design/
/NGO Website Design Enhancement/
about globle interactive ness /

# Photo staging + Cloudinary upload masters.
# NOT part of the shipped site — this repo is the deployed web root, so anything
# here would be publicly served. photos/ is the user's raw archive (3 GB, lives in
# OneDrive); cloudinary-upload/ holds regenerable masters that belong on Cloudinary.
/photos/
/cloudinary-upload/
/photo-review.html
.vscode/
assets/images/programs/education/sid-banner-school-facade.jpg

# Images live on Cloudinary, not in the repo. Every page references
# res.cloudinary.com/usq2sbox/... — the local copies here are upload sources
# and offline fallbacks only. Re-upload with:
#   node --env-file=.env scripts-upload-cloudinary.mjs --swap
/assets/images/

# Annual-report ground truth + content audit. NOT shipped: this repo is the
# subdomain document root, and .htaccess only blocks .md — the .json, .txt and
# .yaml here would be publicly downloadable. AUDIT.json and DISCREPANCY-REPORT
# catalogue every unsupported claim the site used to carry; that is internal.
# Keep this directory locally and back it up somewhere private.
/ground-truth/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Local dev tooling — not part of the shipped site (this repo is the web root).
/.mcp.json
/.ignore
/graft/

# Source delivery folder from the trust (3.2 GB of photos and documents).
# Same rule as photos/: this repo is the deployed web root, so nothing here
# may be served. Publishable documents are copied into assets/Credentials/
# after verification; photographs go to Cloudinary.
/COODU TRUST - PHOTOS FOR WEBSITE/

# Real SMTP credentials for the contact endpoint. Copied from
# assets/php/config.sample.php on the server and filled in there; the repo is
# the public web root, so this must never be committed.
/assets/php/config.php

# Diagnostics are created directly on the server and never committed. The repo
# is PUBLIC, so a token hardcoded in a committed file protects nothing — it is
# published alongside the check it guards. (GitGuardian flagged exactly this on
# 23 Sep 2026.)
/assets/php/diagnose*.php

# Runtime state written by the PHP endpoints: contact submissions, donation
# records and receipt counters. Personal data under the DPDP Act 2023, and the
# repo is the public document root — none of it may be committed. The
# .htaccess files that deny HTTP access to this folder ARE tracked.
/assets/php/data/*
!/assets/php/data/.htaccess
