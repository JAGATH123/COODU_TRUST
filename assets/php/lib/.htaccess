# ==========================================================================
# Vendored PHPMailer. Only contact-submit.php includes it; nothing in here is
# meant to be requested directly over HTTP.
# ==========================================================================

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>

Options -Indexes
